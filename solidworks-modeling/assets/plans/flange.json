{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "圆板法兰",
    "units": "mm"
  },
  "params": {
    "od": 160,
    "bore": 60,
    "t": 18,
    "bcd": 110,
    "n": 6,
    "bolt_d": 13
  },
  "steps": [
    {
      "id": "n",
      "op": "new_part"
    },
    {
      "id": "p",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s1",
      "op": "sketch_begin"
    },
    {
      "id": "c1",
      "op": "circle",
      "d": "{{ params.od }}"
    },
    {
      "id": "s2",
      "op": "sketch_end"
    },
    {
      "id": "e1",
      "op": "extrude_boss",
      "depth": "{{ params.t }}",
      "name": "Plate"
    },
    {
      "id": "p2",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s3",
      "op": "sketch_begin"
    },
    {
      "id": "c2",
      "op": "circle",
      "d": "{{ params.bore }}"
    },
    {
      "id": "s4",
      "op": "sketch_end"
    },
    {
      "id": "cut1",
      "op": "extrude_cut",
      "end_cond": "swEndCondThroughAll",
      "reverse_dir": true,
      "name": "BoreCut"
    },
    {
      "id": "p3",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s5",
      "op": "sketch_begin"
    },
    {
      "id": "bc",
      "op": "circle",
      "cx": "{{ params.bcd/2 }}",
      "d": "{{ params.bolt_d }}"
    },
    {
      "id": "cp",
      "op": "sketch_circular_pattern",
      "count": "{{ params.n }}",
      "cx": 0,
      "cy": 0,
      "angle": 360
    },
    {
      "id": "s6",
      "op": "sketch_end"
    },
    {
      "id": "cut2",
      "op": "extrude_cut",
      "end_cond": "swEndCondThroughAll",
      "reverse_dir": true,
      "name": "BoltHoles"
    },
    {
      "id": "v1",
      "op": "check_bbox",
      "expect": [
        "{{ params.od }}",
        "{{ params.od }}",
        "{{ params.t }}"
      ]
    },
    {
      "id": "v2",
      "op": "check_feature_count",
      "min": 4
    },
    {
      "id": "sv",
      "op": "save_as",
      "path": "D:\\out\\flange.SLDPRT",
      "overwrite": true
    }
  ]
}
