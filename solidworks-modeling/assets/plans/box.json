{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "长方体（最小可运行示例）",
    "units": "mm"
  },
  "params": {
    "w": 80,
    "h": 40,
    "t": 10
  },
  "steps": [
    {
      "id": "n",
      "op": "new_part"
    },
    {
      "id": "p",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s1",
      "op": "sketch_begin"
    },
    {
      "id": "r1",
      "op": "rect_center",
      "w": "{{ params.w }}",
      "h": "{{ params.h }}"
    },
    {
      "id": "s2",
      "op": "sketch_end"
    },
    {
      "id": "e1",
      "op": "extrude_boss",
      "depth": "{{ params.t }}"
    },
    {
      "id": "v1",
      "op": "check_bbox",
      "expect": [
        "{{ params.w }}",
        "{{ params.h }}",
        "{{ params.t }}"
      ]
    },
    {
      "id": "v2",
      "op": "check_feature_count",
      "min": 2
    },
    {
      "id": "sv",
      "op": "save_as",
      "path": "D:\\out\\box.SLDPRT",
      "overwrite": true
    }
  ]
}
