{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "探针 linear_pattern：60×20 板上的 Ø6 孔沿 X 轴阵列 4 个（间距 13，方向用 axis_from_planes 建的基准轴）",
    "units": "mm"
  },
  "params": {},
  "steps": [
    {
      "id": "n",
      "op": "new_part"
    },
    {
      "id": "ax",
      "op": "axis_from_planes",
      "plane1": "Front",
      "plane2": "Top",
      "name": "XAxis"
    },
    {
      "id": "p1",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s1",
      "op": "sketch_begin"
    },
    {
      "id": "r1",
      "op": "rect_corner",
      "x1": -30,
      "y1": -10,
      "x2": 30,
      "y2": 10
    },
    {
      "id": "s2",
      "op": "sketch_end",
      "name": "PlateSk"
    },
    {
      "id": "e1",
      "op": "extrude_boss",
      "depth": 10,
      "end_cond": "swEndCondMidPlane",
      "name": "Plate"
    },
    {
      "id": "p2",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s3",
      "op": "sketch_begin"
    },
    {
      "id": "c1",
      "op": "circle",
      "cx": -20,
      "cy": 0,
      "r": 3
    },
    {
      "id": "s4",
      "op": "sketch_end",
      "name": "HoleSk"
    },
    {
      "id": "ec",
      "op": "extrude_cut",
      "end_cond": "swEndCondThroughAllBoth",
      "both_directions": true,
      "name": "Hole1"
    },
    {
      "id": "lp",
      "op": "linear_pattern",
      "target": "Hole1",
      "count": 4,
      "spacing": 13,
      "name": "LinPattern1",
      "direction": "XAxis"
    },
    {
      "id": "mass",
      "op": "check_mass"
    },
    {
      "id": "diag",
      "op": "check_diagnostics",
      "fail_on": "error"
    },
    {
      "id": "sv",
      "op": "save_as",
      "path": "{{ params.out }}/probe_linear_pattern.SLDPRT",
      "overwrite": true
    }
  ]
}
