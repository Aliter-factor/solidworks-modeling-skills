{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "探针 delete_feature：按名删特征（确定性名称）",
    "units": "mm",
    "note": "覆盖此前无探针的 delete_feature。用 extrude_boss 的 name='TMPBODY' 建一个**名字已知**的特征，再按 kind='feature' 删掉 —— 避免依赖会话随机的配合特征名。判据 = 删完实体数为 0。"
  },
  "params": {},
  "steps": [
    {"id": "np", "op": "new_part"},
    {"id": "pl", "op": "select_plane", "plane": "Front"},
    {"id": "sb", "op": "sketch_begin"},
    {"id": "r1", "op": "rect_corner", "x1": 0, "y1": 0, "x2": 40, "y2": 30},
    {"id": "se", "op": "sketch_end", "name": "DelSk"},
    {"id": "ex", "op": "extrude_boss", "depth": 10, "name": "TMPBODY"},
    {"id": "bb", "op": "check_bbox", "expect": [40, 30, 10], "tol_mm": 0.05},
    {"id": "del", "op": "delete_feature", "name": "TMPBODY", "kind": "feature"},
    {"id": "bd", "op": "check_body", "expect_solid": 0},
    {"id": "dg", "op": "check_diagnostics"},
    {"id": "sv", "op": "save_as", "path": "{{ params.out }}/probe_delete_feature.SLDPRT",
     "overwrite": true}
  ]
}
