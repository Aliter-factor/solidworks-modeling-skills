{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "探针 sketch_circular_pattern：草图圆周阵列（种子圆 + 6 等分）",
    "units": "mm",
    "note": "覆盖此前无探针的 sketch_circular_pattern。种子圆 ρ=20 处（阵列中心取原点）⇒ 阵列半径自动由 last_circle 推出，不用手写 radius。"
  },
  "params": {},
  "steps": [
    {"id": "np", "op": "new_part"},
    {"id": "pl", "op": "select_plane", "plane": "Front"},
    {"id": "sb", "op": "sketch_begin"},
    {"id": "c1", "op": "circle", "cx": 20, "cy": 0, "d": 6},
    {"id": "pat", "op": "sketch_circular_pattern", "count": 6, "cx": 0, "cy": 0},
    {"id": "cs", "op": "check_sketch"},
    {"id": "se", "op": "sketch_end", "name": "CircPatSk"},
    {"id": "ex", "op": "extrude_boss", "depth": 5},
    {"id": "dg", "op": "check_diagnostics"},
    {"id": "sv", "op": "save_as", "path": "{{ params.out }}/probe_sketch_circular_pattern.SLDPRT",
     "overwrite": true}
  ]
}
