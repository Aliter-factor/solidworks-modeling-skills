{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "螺母 M10（nut_m10，六角截面拉伸）",
    "units": "mm",
    "note": "规格来自 reducer.params.json::parts.nut_m10（source=gb，唯一权威表 assets/gb_standard.json）；**不硬编码**。刻意不建螺纹与端部倒角（见代码头注）",
    "source_params": "assets/reducer/reducer.params.json"
  },
  "params": {},
  "steps": [
    {
      "id": "n",
      "op": "new_part"
    },
    {
      "id": "p",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s1",
      "op": "sketch_begin"
    },
    {
      "id": "hx",
      "op": "polyline",
      "points": [
        [
          16.0,
          0.0
        ],
        [
          8.0,
          13.856406
        ],
        [
          -8.0,
          13.856406
        ],
        [
          -16.0,
          0.0
        ],
        [
          -8.0,
          -13.856406
        ],
        [
          8.0,
          -13.856406
        ]
      ],
      "close": true,
      "note": "正六边形 对边宽 s=16（外接圆半径 = s）"
    },
    {
      "id": "hole",
      "op": "circle",
      "cx": 0.0,
      "cy": 0.0,
      "d": 10.0,
      "note": "内孔 Ø10（GB 公称；**光孔，未建内螺纹**）"
    },
    {
      "id": "s2",
      "op": "sketch_end",
      "name": "螺母 M10截面"
    },
    {
      "id": "ck",
      "op": "check_sketch_constraint",
      "sketch": "螺母 M10截面",
      "expect_min_dims": 0,
      "note": "★ 标注已封存 ⇒ 只记录约束状态"
    },
    {
      "id": "ex",
      "op": "extrude_boss",
      "depth": 8.4,
      "end_cond": "swEndCondMidPlane",
      "name": "螺母 M10",
      "note": "两个轮廓（外六角 + 内孔）一次拉伸 —— 参照件同款做法"
    },
    {
      "id": "bb",
      "op": "check_bbox",
      "expect": [
        32.0,
        27.712812921102035,
        8.4
      ],
      "tol": 0.02,
      "note": "正六边形（顶点朝 X）⇒ 包围盒 [32, 27.7128, 8.4]"
    },
    {
      "id": "m",
      "op": "check_mass",
      "expect_mass_g": 4.9272,
      "tol": 0.02,
      "note": "(3√3/2)s²·m − π/4·d²·m = 4927.1686mm³ —— **不与参照件比**（含螺纹件 mass_props 不可信，§83）"
    },
    {
      "id": "diag",
      "op": "check_diagnostics",
      "fail_on": "error"
    },
    {
      "id": "sv",
      "op": "save_as",
      "path": "{{ params.out }}/11-nut_m10-16x10x8.4.SLDPRT",
      "overwrite": true
    }
  ],
  "_derived": {
    "kind": "hex_nut",
    "s": 16.0,
    "d": 10.0,
    "thickness": 8.4,
    "gb": {
      "spec": "M10",
      "s": 16.0,
      "m": 8.4,
      "d": 10.0,
      "e": 17.77
    },
    "analytic_volume_mm3": 4927.168627640314,
    "reference_bbox_mm": [
      18.841,
      15.389,
      9.127
    ]
  }
}
