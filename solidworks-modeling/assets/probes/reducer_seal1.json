{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "密封圈（seal1，圆环半剖面回转）",
    "units": "mm",
    "note": "尺寸来自 reducer.params.json::parts.seal1，不硬编码",
    "source_params": "assets/reducer/reducer.params.json"
  },
  "params": {},
  "steps": [
    {
      "id": "n",
      "op": "new_part"
    },
    {
      "id": "p",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s1",
      "op": "sketch_begin"
    },
    {
      "id": "cl",
      "op": "centerline",
      "x1": 0.0,
      "y1": 0.0,
      "x2": 4.0,
      "y2": 0.0
    },
    {
      "id": "prof",
      "op": "polyline",
      "points": [
        [
          0.0,
          15.0
        ],
        [
          4.0,
          15.0
        ],
        [
          4.0,
          23.0
        ],
        [
          0.0,
          23.0
        ]
      ],
      "close": true
    },
    {
      "id": "s2",
      "op": "sketch_end",
      "name": "密封圈半剖面"
    },
    {
      "id": "ck",
      "op": "check_sketch_constraint",
      "sketch": "密封圈半剖面",
      "expect_min_dims": 0,
      "note": "★ 尺寸标注已封存 ⇒ 不校验尺寸条数，只记录约束状态；几何正确性由 check_bbox / check_mass 兜"
    },
    {
      "id": "rev",
      "op": "revolve_boss",
      "angle": 360,
      "name": "密封圈"
    },
    {
      "id": "bb",
      "op": "check_bbox",
      "expect": [
        4.0,
        46.0,
        46.0
      ],
      "tol": 0.05,
      "note": "与参照件 18-密封圈.SLDPRT 的包围盒一致（[4, 46, 46]）"
    },
    {
      "id": "cyl",
      "op": "check_cyl_radius",
      "expect_max": 23.0,
      "tol": 0.01
    },
    {
      "id": "m",
      "op": "check_mass",
      "expect_mass_g": 3.8202,
      "tol": 0.02,
      "note": "π/4(D²−d²)t —— 内孔对不对，靠这条兜底"
    },
    {
      "id": "diag",
      "op": "check_diagnostics",
      "fail_on": "error"
    },
    {
      "id": "sv",
      "op": "save_as",
      "path": "{{ params.out }}/18-ring-46x30x4.SLDPRT",
      "overwrite": true
    }
  ],
  "_derived": {
    "OD": 46.0,
    "ID": 30.0,
    "t": 4.0,
    "ri": 15.0,
    "ro": 23.0,
    "analytic_volume_mm3": 3820.176666765188
  }
}
