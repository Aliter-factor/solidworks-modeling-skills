      "op": "new_part"
    },
    {
      "id": "p",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s1",
      "op": "sketch_begin"
    },
    {
      "id": "cl",
      "op": "centerline",
      "x1": 0,
      "y1": -5,
      "x2": 0,
      "y2": 45
    },
    {
      "id": "r1",
      "op": "rect_corner",
      "x1": 20,
      "y1": 0,
      "x2": 30,
      "y2": 40
    },
    {
      "id": "s2",
      "op": "sketch_end",
      "name": "RevSk"
    },
    {
      "id": "rv",
      "op": "surface_revolve",
      "angle": 360,
      "name": "Rev1"
    },
    {
      "id": "bb",
      "op": "check_bbox",
      "expect": [60, 40, 60],
      "tol_mm": 0.1
    },
    {
      "id": "cb1",
      "op": "check_body",
      "expect_sheet": 1,
      "expect_solid": 0,
      "expect_area_mm2": 15707.9633,
      "area_tol": 0.001
    },
    {
      "id": "tk",
      "op": "thicken",
      "targets": ["Rev1"],
      "thickness": 3,
      "direction": "side1",
      "name": "RevSolid"
    },
    {
      "id": "cb2",
      "op": "check_body",
      "expect_sheet": 0,
      "expect_solid": 1
    },
    {
      "id": "m1",
      "op": "check_mass",
      "expect_volume_mm3": 41469.02,
      "vol_tol": 0.01
    }
  ]
}
