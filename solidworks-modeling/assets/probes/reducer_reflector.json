{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "反光片（reflector，球冠型面回转 + 3×Ø4 孔 + 2×Ø3 斜槽）",
    "units": "mm",
    "note": "型面来自 reducer.params.json::parts.reflector.profile，偏心特征来自 parts.reflector._measured_faces.solved（sw_profile 实测），不硬编码",
    "source_params": "assets/reducer/reducer.params.json"
  },
  "params": {
    "out": "D:/out/reducer"
  },
  "steps": [
    {
      "id": "n",
      "op": "new_part"
    },
    {
      "id": "p",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s1",
      "op": "sketch_begin"
    },
    {
      "id": "cl",
      "op": "centerline",
      "x1": 0.0,
      "y1": 0.0,
      "x2": 4.125,
      "y2": 0.0
    },
    {
      "id": "prof",
      "op": "polyline",
      "points": [
        [
          2.0,
          8.2301
        ],
        [
          2.0,
          17.0
        ],
        [
          0.0,
          17.0
        ],
        [
          0.0,
          7.4498
        ]
      ],
      "close": false,
      "note": "实测型面直线串 4 点（球冠/球窝那两段交给圆弧收口）"
    },
    {
      "id": "arc0",
      "op": "arc3p",
      "p1": [
        0.0,
        7.4498
      ],
      "p2": [
        2.0,
        0.0
      ],
      "p3": [
        1.4913,
        3.8568
      ],
      "note": "R14.875 球面母线（**起点/终点/弧上点** 的顺序）—— 收口成闭环"
    },
    {
      "id": "arc1",
      "op": "arc3p",
      "p1": [
        4.125,
        0.0
      ],
      "p2": [
        2.0,
        8.2301
      ],
      "p3": [
        3.5852,
        4.25
      ],
      "note": "R17 球面母线（**起点/终点/弧上点** 的顺序）—— 收口成闭环"
    },
    {
      "id": "s2",
      "op": "sketch_end",
      "name": "反光片半剖面"
    },
    {
      "id": "ck",
      "op": "check_sketch_constraint",
      "sketch": "反光片半剖面",
      "expect_min_dims": 0,
      "note": "★ 尺寸标注已封存 ⇒ 只记录约束状态，几何由下三条兜"
    },
    {
      "id": "rev",
      "op": "revolve_boss",
      "angle": 360,
      "name": "反光片"
    },
    {
      "id": "bb",
      "op": "check_bbox",
      "expect": [
        4.125,
        34.0,
        34.0
      ],
      "tol_mm": 0.05,
      "note": "与参照件 3-反光片.SLDPRT 的包围盒一致（[4.125, 34, 34]）"
    },
    {
      "id": "cyl",
      "op": "check_cyl_radius",
      "expect_max": 17.0,
      "tol": 0.01
    },
    {
      "id": "m0",
      "op": "check_mass",
      "expect_volume_mm3": 1868.367,
      "vol_tol": 0.005,
      "note": "Pappus 2π·r̄·A = 1868.367mm³（球冠弧+球窝弧都在轮廓里，错一处立刻红）"
    },
    {
      "id": "ax",
      "op": "axis_from_planes",
      "plane1": "Front",
      "plane2": "Top",
      "name": "Axis1",
      "note": "阵列轴 = 回转轴 = 全局 X（Front ∩ Top）"
    },
    {
      "id": "p2",
      "op": "select_plane",
      "plane": "Right",
      "note": "孔位草图开在 Right 基准面（法向 X）—— 平面在零件左侧之外，双向贯穿切到环"
    },
    {
      "id": "s3",
      "op": "sketch_begin",
      "reset": true
    },
    {
      "id": "cl2",
      "op": "centerline",
      "x1": 0.0,
      "y1": 0.0,
      "x2": 17.0,
      "y2": 0.0
    },
    {
      "id": "c1",
      "op": "circle",
      "cx": 12.0,
      "cy": 0.0,
      "d": 4.0,
      "note": "Ø4 种子孔，距原点 12（分布圆 Ø24）"
    },
    {
      "id": "s4",
      "op": "sketch_end",
      "name": "反光片孔位"
    },
    {
      "id": "ck2",
      "op": "check_sketch_constraint",
      "sketch": "反光片孔位",
      "expect_min_dims": 0,
      "note": "★ 只记录约束状态；孔对不对由 m1 兜"
    },
    {
      "id": "cut",
      "op": "extrude_cut",
      "end_cond": "swEndCondThroughAllBoth",
      "both_directions": true,
      "name": "反光片孔",
      "note": "双向贯穿 —— 草图平面骑在零件外侧，单向穿不透"
    },
    {
      "id": "cp",
      "op": "circular_pattern",
      "target": "反光片孔",
      "axis": "Axis1",
      "count": 3,
      "angle": 360,
      "name": "反光片孔阵",
      "note": "整圈 3 个（含原始那个）"
    },
    {
      "id": "m1",
      "op": "check_mass",
      "expect_volume_mm3": 1792.968,
      "vol_tol": 0.005,
      "note": "回转 1868.367 − 3×π/4·4²·2 = 1792.968mm³"
    },
    {
      "id": "p30",
      "op": "select_plane",
      "plane": "Front",
      "note": "每次开草图前都要重选基准面（上一特征清空了选择集）"
    },
    {
      "id": "s50",
      "op": "sketch_begin",
      "reset": true
    },
    {
      "id": "org0",
      "op": "point",
      "x": 0.0,
      "y": 0.0,
      "note": "★ 原点锚（S7）：斜槽回转轴**天生离轴**（到 X 轴 r≈0.926，与 X 轴成 17.5°）⇒ 轴永远过不了原点。补一个落在草图原点的构造点锁住定位自由度。**不放中心线**——`revolve_cut` 的兜底会抓草图里**第一条**中心线当旋转轴，多一条会把轴抓错。"
    },
    {
      "id": "clv0",
      "op": "centerline",
      "x1": -1.0148489999999994,
      "y1": 1.828118,
      "x2": 4.707453000000001,
      "y2": 3.632354,
      "note": "斜槽0回转轴：过 (-1.015, 1.828)，方向 [0.953717, 0.300706]（与 X 轴成 ±17.5°）"
    },
    {
      "id": "rv0",
      "op": "polyline",
      "points": [
        [
          -1.0148489999999994,
          1.828118
        ],
        [
          4.707453000000001,
          3.632354
        ],
        [
          4.256394000000001,
          5.0629295
        ],
        [
          -1.4659079999999993,
          3.2586934999999997
        ]
      ],
      "close": true,
      "note": "矩形**从斜轴延伸到 r=1.5** ⇒ 回转出实心 Ø3 圆柱槽"
    },
    {
      "id": "s60",
      "op": "sketch_end",
      "name": "反光片斜槽0"
    },
    {
      "id": "cks0",
      "op": "check_sketch",
      "sketch": "反光片斜槽0",
      "note": "体检：应为 4 段 LINE（矩形）+ 1 段 LINE（中心线）"
    },
    {
      "id": "ck30",
      "op": "check_sketch_constraint",
      "sketch": "反光片斜槽0",
      "expect_min_dims": 0,
      "note": "★ 只记录约束状态；斜槽对不对由 m2 兜"
    },
    {
      "id": "rcut0",
      "op": "revolve_cut",
      "angle": 360,
      "profile": "反光片斜槽0",
      "name": "反光片斜槽0",
      "note": "绕**草图内中心线**旋转切除；★ 必须显式给 profile，别走 last_sketch"
    },
    {
      "id": "p31",
      "op": "select_plane",
      "plane": "Front",
      "note": "每次开草图前都要重选基准面（上一特征清空了选择集）"
    },
    {
      "id": "s51",
      "op": "sketch_begin",
      "reset": true
    },
    {
      "id": "org1",
      "op": "point",
      "x": 0.0,
      "y": 0.0,
      "note": "★ 原点锚（S7）：斜槽回转轴**天生离轴**（到 X 轴 r≈0.926，与 X 轴成 17.5°）⇒ 轴永远过不了原点。补一个落在草图原点的构造点锁住定位自由度。**不放中心线**——`revolve_cut` 的兜底会抓草图里**第一条**中心线当旋转轴，多一条会把轴抓错。"
    },
    {
      "id": "clv1",
      "op": "centerline",
      "x1": -1.0148489999999994,
      "y1": -1.828118,
      "x2": 4.707453000000001,
      "y2": -3.632354,
      "note": "斜槽1回转轴：过 (-1.015, -1.828)，方向 [0.953717, -0.300706]（与 X 轴成 ±17.5°）"
    },
    {
      "id": "rv1",
      "op": "polyline",
      "points": [
        [
          -1.0148489999999994,
          -1.828118
        ],
        [
          4.707453000000001,
          -3.632354
        ],
        [
          5.158512000000001,
          -2.2017784999999996
        ],
        [
          -0.5637899999999995,
          -0.3975424999999999
        ]
      ],
      "close": true,
      "note": "矩形**从斜轴延伸到 r=1.5** ⇒ 回转出实心 Ø3 圆柱槽"
    },
    {
      "id": "s61",
      "op": "sketch_end",
      "name": "反光片斜槽1"
    },
    {
      "id": "cks1",
      "op": "check_sketch",
      "sketch": "反光片斜槽1",
      "note": "体检：应为 4 段 LINE（矩形）+ 1 段 LINE（中心线）"
    },
    {
      "id": "ck31",
      "op": "check_sketch_constraint",
      "sketch": "反光片斜槽1",
      "expect_min_dims": 0,
      "note": "★ 只记录约束状态；斜槽对不对由 m2 兜"
    },
    {
      "id": "rcut1",
      "op": "revolve_cut",
      "angle": 360,
      "profile": "反光片斜槽1",
      "name": "反光片斜槽1",
      "note": "绕**草图内中心线**旋转切除；★ 必须显式给 profile，别走 last_sketch"
    },
    {
      "id": "m2",
      "op": "check_mass",
      "expect_volume_mm3": 1762.706,
      "vol_tol": 0.005,
      "note": "含 2 斜槽后对照参照件 1762.706mm³（真机实测 1762.7106，差 0.0003%）。斜槽切料量解析不可算 ⇒ 靶值直接取参照件体积，tol 收到 0.5% 兜回归"
    },
    {
      "id": "diag",
      "op": "check_diagnostics",
      "fail_on": "error"
    },
    {
      "id": "sv",
      "op": "save_as",
      "path": "{{ params.out }}/3-reflector-34x4.125.SLDPRT",
      "overwrite": true
    }
  ],
  "_derived": {
    "L": 4.125,
    "Df": 34.0,
    "r_max": 17.0,
    "n_arcs": 2,
    "turn_volume_mm3": 1868.3665622146234,
