{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "探针 mirror：把 Plate 上的 Hole1 关于右视面镜像（特征级镜像）",
    "units": "mm"
  },
  "params": {},
  "steps": [
    {
      "id": "n",
      "op": "new_part"
    },
    {
      "id": "p1",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s1",
      "op": "sketch_begin"
    },
    {
      "id": "r1",
      "op": "rect_corner",
      "x1": -30,
      "y1": -10,
      "x2": 30,
      "y2": 10
    },
    {
      "id": "s2",
      "op": "sketch_end",
      "name": "PlateSk"
    },
    {
      "id": "e1",
      "op": "extrude_boss",
      "depth": 10,
      "end_cond": "swEndCondMidPlane",
      "name": "Plate"
    },
    {
      "id": "p2",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s3",
      "op": "sketch_begin"
    },
    {
      "id": "c1",
      "op": "circle",
      "cx": 20,
      "cy": 0,
      "r": 5
    },
    {
      "id": "s4",
      "op": "sketch_end",
      "name": "HoleSk"
    },
    {
      "id": "ec",
      "op": "extrude_cut",
      "end_cond": "swEndCondThroughAllBoth",
      "both_directions": true,
      "name": "Hole1"
    },
    {
      "id": "mr",
      "op": "mirror",
      "target": "Hole1",
      "plane": "Right",
      "name": "Mirror1"
    },
    {
      "id": "mass",
      "op": "check_mass"
    },
    {
      "id": "diag",
      "op": "check_diagnostics",
      "fail_on": "error"
    },
    {
      "id": "sv",
      "op": "save_as",
      "path": "{{ params.out }}/probe_mirror.SLDPRT",
      "overwrite": true
    }
  ]
}
