{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "端盖4（cover4，闷盖半剖面回转）",
    "units": "mm",
    "note": "尺寸来自 reducer.params.json::parts.cover4，不硬编码",
    "source_params": "assets/reducer/reducer.params.json"
  },
  "params": {},
  "steps": [
    {
      "id": "n",
      "op": "new_part"
    },
    {
      "id": "p",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s1",
      "op": "sketch_begin"
    },
    {
      "id": "cl",
      "op": "centerline",
      "x1": 0.0,
      "y1": 0.0,
      "x2": 7.0,
      "y2": 0.0
    },
    {
      "id": "prof",
      "op": "polyline",
      "points": [
        [
          0.0,
          25.0
        ],
        [
          0.0,
          34.0
        ],
        [
          3.0,
          34.0
        ],
        [
          3.0,
          31.0
        ],
        [
          7.0,
          31.0
        ],
        [
          7.0,
          0.0
        ],
        [
          3.0,
          0.0
        ],
        [
          3.0,
          25.0
        ]
      ],
      "close": true,
      "note": "法兰 Ø68/孔 Ø50/3 + 实心凸台 Ø62/4"
    },
    {
      "id": "s2",
      "op": "sketch_end",
      "name": "端盖4半剖面"
    },
    {
      "id": "ck",
      "op": "check_sketch_constraint",
      "sketch": "端盖4半剖面",
      "expect_min_dims": 0,
      "note": "★ 尺寸标注已封存 ⇒ 不校验尺寸条数，只记录约束状态；几何正确性由 check_bbox / check_mass 兜"
    },
    {
      "id": "rev",
      "op": "revolve_boss",
      "angle": 360,
      "name": "端盖4"
    },
    {
      "id": "bb",
      "op": "check_bbox",
      "expect": [
        7.0,
        68.0,
        68.0
      ],
      "tol": 0.05,
      "note": "与参照件 31-端盖4.SLDPRT 的包围盒一致（[7, 68, 68]）"
    },
    {
      "id": "cyl",
      "op": "check_cyl_radius",
      "expect_max": 34.0,
      "tol": 0.01
    },
    {
      "id": "m",
      "op": "check_mass",
      "expect_mass_g": 17.0808,
      "tol": 0.02,
      "note": "π/4(Df²−di²)tf + π/4·Ds²·ts —— 孔与凸台对不对，靠这条兜底"
    },
    {
      "id": "diag",
      "op": "check_diagnostics",
      "fail_on": "error"
    },
    {
      "id": "sv",
      "op": "save_as",
      "path": "{{ params.out }}/31-cover-68x50x7.SLDPRT",
      "overwrite": true
    }
  ],
  "_derived": {
    "Df": 68.0,
    "di": 50.0,
    "tf": 3.0,
    "Ds": 62.0,
    "ts": 4.0,
    "L": 7.0,
    "ri": 25.0,
    "rs": 31.0,
    "ro": 34.0,
    "analytic_volume_mm3": 17080.839257567706
  }
