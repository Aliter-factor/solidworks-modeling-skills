{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "螺钉 M3×10（screw_m3x10，实测型面半剖面回转）",
    "units": "mm",
    "note": "型面来自 reducer.params.json::parts.screw_m3x10.profile（sw_profile 从参照件面的边界圆重建，Pappus 已对账）",
    "source_params": "assets/reducer/reducer.params.json"
  },
  "params": {},
  "steps": [
    {
      "id": "n",
      "op": "new_part"
    },
    {
      "id": "p",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s1",
      "op": "sketch_begin"
    },
    {
      "id": "cl",
      "op": "centerline",
      "x1": 0.0,
      "y1": 0.0,
      "x2": 12.4,
      "y2": 0.0
    },
    {
      "id": "prof",
      "op": "polyline",
      "points": [
        [
          0.0,
          0.0
        ],
        [
          0.0,
          2.8
        ],
        [
          2.4,
          2.8
        ],
        [
          2.4,
          1.5
        ],
        [
          12.4,
          1.5
        ],
        [
          12.4,
          0.0
        ]
      ],
      "close": true,
      "note": "实测型面直线串 6 点（非单调：轴向进进出出）；闭合方式=自己闭合"
    },
    {
      "id": "s2",
      "op": "sketch_end",
      "name": "螺钉 M3×10半剖面"
    },
    {
      "id": "ck",
      "op": "check_sketch_constraint",
      "sketch": "螺钉 M3×10半剖面",
      "expect_min_dims": 0,
      "note": "★ 尺寸标注已封存 ⇒ 不校验尺寸条数，只记录约束状态"
    },
    {
      "id": "rev",
      "op": "revolve_boss",
      "angle": 360,
      "name": "螺钉 M3×10"
    },
    {
      "id": "bb",
      "op": "check_bbox",
      "expect": [
        12.4,
        5.6,
        5.6
      ],
      "tol": 0.05,
      "note": "与参照件 9-螺钉M3x10.SLDPRT 的包围盒一致（[12.4, 5.6, 5.6]）"
    },
    {
      "id": "cyl",
      "op": "check_cyl_radius",
      "expect_max": 2.8,
      "tol": 0.01
    },
    {
      "id": "m",
      "op": "check_mass",
      "expect_mass_g": 0.1298,
      "tol": 0.02,
      "note": "Pappus 2π·r̄·A 由型面现算 —— 型面/毡圈槽/圆弧任何一处错，这条立刻红"
    },
    {
      "id": "diag",
      "op": "check_diagnostics",
      "fail_on": "error"
    },
    {
      "id": "sv",
      "op": "save_as",
      "path": "{{ params.out }}/9-screw_m3x10-5.6x12.4.SLDPRT",
      "overwrite": true
    }
  ],
  "_derived": {
    "L": 12.4,
    "Df": 5.6,
    "r_max": 2.8,
    "n_elements": 6,
    "n_arcs": 0,
    "analytic_volume_mm3": 129.7980420757159,
    "reference_volume_mm3": 129.7980420757159
  }
}
