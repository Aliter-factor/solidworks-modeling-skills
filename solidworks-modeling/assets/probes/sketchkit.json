{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "探针 sketchkit：矩形草图圆角 + 正六边形 + 草图点（补齐草图类 op）",
    "units": "mm"
  },
  "params": {},
  "steps": [
    {
      "id": "n",
      "op": "new_part"
    },
    {
      "id": "p1",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s1",
      "op": "sketch_begin"
    },
    {
      "id": "r1",
      "op": "rect_corner",
      "x1": -20,
      "y1": -15,
      "x2": 20,
      "y2": 15
    },
    {
      "id": "sf",
      "op": "sketch_fillet",
      "r": 3,
      "which": [
        0,
        1
      ]
    },
    {
      "id": "s2",
      "op": "sketch_end",
      "name": "KitSk"
    },
    {
      "id": "ck1",
      "op": "check_sketch",
      "sketch": "KitSk"
    },
    {
      "id": "e1",
      "op": "extrude_boss",
      "depth": 10,
      "name": "Kit"
    },
    {
      "id": "bb",
      "op": "check_bbox",
      "expect": [40, 30, 10],
      "tol": 0.05
    },
    {
      "id": "p2",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s3",
      "op": "sketch_begin"
    },
    {
      "id": "pg",
      "op": "polygon",
      "n": 6,
      "r": 8,
      "cx": 0,
      "cy": 0,
      "rot": 0
    },
    {
      "id": "pt",
      "op": "point",
      "points": [
        [25, 0],
        [-25, 0]
      ]
    },
    {
      "id": "s4",
      "op": "sketch_end",
      "name": "ToolSk",
      "select": false
    },
    {
      "id": "ck2",
      "op": "check_sketch",
      "sketch": "ToolSk"
    },
    {
      "id": "diag",
      "op": "check_diagnostics",
      "fail_on": "error"
    },
    {
      "id": "sv",
      "op": "save_as",
      "path": "{{ params.out }}/probe_sketchkit.SLDPRT",
      "overwrite": true
    }
  ]
}
