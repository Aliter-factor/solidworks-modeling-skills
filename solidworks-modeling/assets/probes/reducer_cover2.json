    },
    {
      "id": "rev",
      "op": "revolve_boss",
      "angle": 360,
      "name": "端盖2"
    },
    {
      "id": "bb",
      "op": "check_bbox",
      "expect": [
        7.0,
        54.0,
        54.0
      ],
      "tol": 0.05,
      "note": "与参照件 22-端盖2.SLDPRT 的包围盒一致（[7, 54, 54]）"
    },
    {
      "id": "cyl",
      "op": "check_cyl_radius",
