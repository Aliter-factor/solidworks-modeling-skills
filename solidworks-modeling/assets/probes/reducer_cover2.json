    },
    {
      "id": "prof",
      "op": "polyline",
      "points": [
        [
          0.0,
          15.5
        ],
        [
          0.0,
          27.0
        ],
        [
          3.0,
          27.0
        ],
        [
          3.0,
          23.5
        ],
        [
          7.0,
          23.5
        ],
        [
          7.0,
          0.0
        ],
        [
          3.0,
          0.0
        ],
        [
          3.0,
          15.5
        ]
