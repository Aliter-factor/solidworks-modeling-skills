{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "窥视孔盖（cover_eye，板+中央圆孔 Ø11+4孔 一次拉伸）",
    "units": "mm",
    "note": "规格来自 reducer.params.json::parts.cover_eye（source=measured，sw_inspect + sw_faces + 端面面积反解）；**不硬编码**",
    "source_params": "assets/reducer/reducer.params.json"
  },
  "params": {},
  "steps": [
    {
      "id": "n",
      "op": "new_part"
    },
    {
      "id": "p",
      "op": "select_plane",
      "plane": "Front",
      "note": "板面 = XY（**Front**，法向 Z）"
    },
    {
      "id": "s1",
      "op": "sketch_begin"
    },
    {
      "id": "cl",
      "op": "centerline",
      "x1": -23.0,
      "y1": 0.0,
      "x2": 23.0,
      "y2": 0.0,
      "note": "X 向对称中心线（构造线）"
    },
    {
      "id": "cl2",
      "op": "centerline",
      "x1": 0.0,
      "y1": -23.0,
      "x2": 0.0,
      "y2": 23.0,
      "note": "Y 向对称中心线（构造线）"
    },
    {
      "id": "out",
      "op": "rect_corner",
      "x1": -23.0,
      "y1": -23.0,
      "x2": 23.0,
      "y2": 23.0,
      "note": "板外形 46×46"
    },
    {
      "id": "win",
      "op": "circle",
      "cx": 0.0,
      "cy": 0.0,
      "d": 11.0,
      "note": "中央圆孔 Ø11（**端面面积反解**所得：46²−1982.48−4·π/4·3.5² = 95.03 ⇒ Ø11.000）"
    },
    {
      "id": "h0",
      "op": "circle",
      "cx": -18.0,
      "cy": 18.0,
      "d": 3.5,
      "note": "角孔 Ø3.5 @ (-18,18)"
    },
    {
      "id": "h1",
      "op": "circle",
      "cx": 18.0,
      "cy": 18.0,
      "d": 3.5,
      "note": "角孔 Ø3.5 @ (18,18)"
    },
    {
      "id": "h2",
      "op": "circle",
      "cx": -18.0,
      "cy": -18.0,
      "d": 3.5,
      "note": "角孔 Ø3.5 @ (-18,-18)"
    },
    {
      "id": "h3",
      "op": "circle",
      "cx": 18.0,
      "cy": -18.0,
      "d": 3.5,
      "note": "角孔 Ø3.5 @ (18,-18)"
    },
    {
      "id": "s2",
      "op": "sketch_end",
      "name": "窥视孔盖截面"
    },
    {
      "id": "ck",
      "op": "check_sketch_constraint",
      "sketch": "窥视孔盖截面",
      "expect_min_dims": 0,
      "note": "★ 标注已封存 ⇒ 只记录约束状态（本图 7 个轮廓）"
    },
    {
      "id": "ex",
      "op": "extrude_boss",
      "depth": 3.0,
      "end_cond": "swEndCondMidPlane",
      "name": "窥视孔盖",
      "note": "**7 个轮廓一次拉伸**（外框+中央圆孔 Ø11+4 孔），与参照件做法一致"
    },
    {
      "id": "bb",
      "op": "check_bbox",
      "expect": [
        46.0,
        46.0,
        3.0
      ],
      "tol": 0.02,
      "note": "板外形 46×46×3"
    },
    {
      "id": "cyl",
      "op": "check_cyl_radius",
      "expect_count": 5,
      "expect_max": 5.5,
      "tol": 0.01,
      "note": "**4 个 Ø3.5 通孔**（中央圆孔 Ø11）—— 孔数+孔径一起钉住（只看 bbox 抓不到）。★ 圆柱面总数 5 = 4 个角孔 + 1 个中央圆孔，最大半径 5.5mm（= 中央圆孔）"
    },
    {
      "id": "m",
      "op": "check_mass",
      "expect_mass_g": 5.9474,
      "tol": 0.02,
      "note": "(L·W − 开口面积 − 4·π/4·d²)·t = 5947.4469mm³（开口 中央圆孔 Ø11）"
    },
    {
      "id": "diag",
      "op": "check_diagnostics",
      "fail_on": "error"
    },
    {
      "id": "sv",
      "op": "save_as",
      "path": "{{ params.out }}/8-cover_eye-46x46x3.SLDPRT",
      "overwrite": true
    }
  ],
  "_derived": {
    "L": 46.0,
    "W": 46.0,
    "t": 3.0,
    "window_shape": "circle",
    "window": 11.0,
    "window_area_mm2": 95.0332,
    "hole_d": 3.5,
    "cyl_expect": {
      "count": 5,
      "max_r": 5.5
    },
    "hole_pitch": [
      18.0,
      18.0
    ],
    "n_holes": 4,
    "analytic_volume_mm3": 5947.4469,
    "reference_volume_mm3": 5947.45
  }
}
