{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "探针 gb_hex_bolt：按 GB/T 5782 自建 M8×30 六角头螺栓 —— 尺寸全部来自 gb_standard.json，并让计划自证没抄错；螺纹走真实螺纹线，收尾用圆柱面半径不变式（不用包围盒）",
    "units": "mm"
  },
  "params": {
    "s": 13,
    "k": 5.3,
    "d": 8,
    "pitch": 1.25,
    "L": 30,
    "thread_len": 20
  },
  "steps": [
    {
      "id": "gbh",
      "op": "lookup_standard",
      "family": "hex_bolt",
      "spec": "M8",
      "expect": { "d": 8, "pitch": 1.25, "s": 13, "k": 5.3 },
      "note": "★ 需求 5：先查权威表并自证。计划里手抄的 13/5.3 若跟表对不上，这一步就当场抛。"
    },
    {
      "id": "gbt",
      "op": "lookup_standard",
      "what": "pitch",
      "spec": "M8"
    },
    {
      "id": "gbtap",
      "op": "lookup_standard",
      "what": "tap_drill",
      "spec": "M8"
    },
    {
      "id": "n",
      "op": "new_part"
    },
    {
      "id": "p1",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s1",
      "op": "sketch_begin"
    },
    {
      "id": "hex",
      "op": "polygon",
      "n": 6,
      "r": "{{ params.s/2/cos(pi/6) }}",
      "note": "r 是外接圆半径 = s/2/cos30°；写 s/2 是最常见的错。"
    },
    {
      "id": "s2",
      "op": "sketch_end",
      "name": "头轮廓"
    },
    {
      "id": "h1",
      "op": "extrude_boss",
      "depth": "{{ params.k }}",
      "name": "六角头"
    },
    {
      "id": "p2",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s3",
      "op": "sketch_begin"
    },
    {
      "id": "cd",
      "op": "circle",
      "d": "{{ params.d }}"
    },
    {
      "id": "s4",
      "op": "sketch_end",
      "name": "杆轮廓"
    },
    {
      "id": "h2",
      "op": "extrude_boss",
      "depth": "{{ params.L }}",
      "name": "杆"
    },
    {
      "id": "th",
      "op": "real_thread",
      "edges": [
        {
          "point": [0, 0, "{{ params.L }}"]
        }
      ],
      "standard": "metric_die",
      "diameter": "{{ params.d }}",
      "pitch": "{{ params.pitch }}",
      "end_condition": "blind",
      "depth": "{{ params.thread_len }}",
      "note": "edges 给杆端圆边的**圆心**；螺纹长度从该边往杆内量。"
    },
    {
      "id": "cyl",
      "op": "check_cyl_radius",
      "expect_max": 4.0,
      "tol": 0.02,
      "note": "★ 牙顶必须齐轴径（Ø8 → r=4.0）。有螺纹时**绝不能**用 check_bbox：螺旋面是 B 样条面，包围盒会虚报。"
    },
    {
      "id": "m",
      "op": "check_mass"
    },
    {
      "id": "fc",
      "op": "check_feature_count",
      "min": 3
    },
    {
      "id": "zf",
      "op": "zoom_fit"
    },
    {
      "id": "diag",
      "op": "check_diagnostics",
      "fail_on": "error"
    },
    {
      "id": "sv",
      "op": "save_as",
      "path": "{{ params.out }}/probe_gb_hex_bolt.SLDPRT",
      "overwrite": true
    }
  ]
}
