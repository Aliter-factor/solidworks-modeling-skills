{
 "schema": "yoyo.swplan/1",
 "meta": {"name": "Right面草图u轴符号探针", "units": "mm",
          "note": "Front小凸台(Z 0..10) + Right面(u=70,v=0)10x10凸台深5：u→+Z则Z跨度75，u→-Z则Z跨度85。"},
 "params": {"out": "D:/out"},
 "steps": [
  {"id": "n", "op": "new_part"},
  {"id": "p1", "op": "select_plane", "plane": "Front"},
  {"id": "s1", "op": "sketch_begin"},
  {"id": "c1", "op": "circle", "cx": 0, "cy": 0, "d": 10},
  {"id": "s2", "op": "sketch_end"},
  {"id": "e1", "op": "extrude_boss", "depth": 10, "end_cond": "swEndCondBlind"},
  {"id": "p2", "op": "select_plane", "plane": "Right"},
  {"id": "s3", "op": "sketch_begin"},
  {"id": "r1", "op": "rect_center", "cx": 70, "cy": 0, "w": 10, "h": 10},
  {"id": "s4", "op": "sketch_end"},
  {"id": "e2", "op": "extrude_boss", "depth": 5, "end_cond": "swEndCondBlind"},
  {"id": "v1", "op": "check_bbox", "expect": [50, 50, 78]}
 ]
}
