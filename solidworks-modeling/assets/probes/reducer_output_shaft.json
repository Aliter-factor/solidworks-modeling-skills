{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "轴（20-轴，半剖面回转）",
    "units": "mm",
    "note": "分段表来自 reducer.params.json::shafts.output.segments，不硬编码",
    "source_params": "assets/reducer/reducer.params.json"
  },
  "params": {},
  "steps": [
    {
      "id": "n",
      "op": "new_part"
    },
    {
      "id": "p",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s1",
      "op": "sketch_begin"
    },
    {
      "id": "prof",
      "op": "shaft_profile",
      "segments": [
        {
          "d": 30.0,
          "l": 30.0,
          "name": "轴承位(6206)"
        },
        {
          "d": 32.0,
          "l": 26.0,
          "name": "齿轮位(与大齿轮孔/宽一致)"
        },
        {
          "d": 38.0,
          "l": 13.0,
          "name": "轴肩"
        },
        {
          "d": 27.0,
          "l": 2.0,
          "name": "越程槽"
        },
        {
          "d": 30.0,
          "l": 14.0,
          "name": "轴承位2(6206)"
        },
        {
          "d": 28.0,
          "l": 24.0,
          "name": "挡油环位"
        },
        {
          "d": 27.32,
          "l": 1.5,
          "name": "锥过渡(45°)"
        },
        {
          "d": 24.317,
          "l": 29.5,
          "name": "输出端(键8x7)"
        }
      ],
      "end_chamfer": 2.0,
      "note": "Σl = 140；两端各 2×45° ⇒ 总长 144"
    },
    {
      "id": "zf0",
      "op": "zoom_fit"
    },
    {
      "id": "zf0b",
      "op": "zoom_fit",
      "note": "★ 连调两次（长细件一次会装不下）"
    },
    {
      "id": "s2",
      "op": "sketch_end",
      "name": "轴半剖面"
    },
    {
      "id": "cksk",
      "op": "check_sketch",
      "sketch": "轴半剖面"
    },
    {
      "id": "ck",
      "op": "check_sketch_constraint",
      "sketch": "轴半剖面",
      "expect_min_dims": 0,
      "note": "★ 尺寸标注已封存 ⇒ 不校验尺寸条数，只记录约束状态；几何正确性由 check_bbox / check_mass 兜"
    },
    {
      "id": "rev",
      "op": "revolve_boss",
      "name": "轴体",
      "angle": 360
    },
    {
      "id": "bb",
      "op": "check_bbox",
      "expect": [
        144.0,
        38.0,
        38.0
      ],
      "tol": 0.05,
      "note": "与参照件 20-轴 的包围盒一致（144/38/38）"
    },
    {
      "id": "cyl",
      "op": "check_cyl_radius",
      "expect_max": 19.0,
      "tol": 0.01
    },
    {
      "id": "m",
      "op": "check_mass",
      "expect_mass_g": 97.2585,
      "tol": 0.02,
      "note": "解析体积按分段圆柱算；端部倒角外扩会略微超，2% 闸门"
    },
    {
      "id": "diag",
      "op": "check_diagnostics",
      "fail_on": "error"
    },
    {
      "id": "sv",
      "op": "save_as",
      "path": "{{ params.out }}/20-shaft.SLDPRT",
      "overwrite": true
    }
  ],
  "_derived": {
    "journal": 30.0,
    "bearing": "6206",
    "sum_l": 140.0,
    "analytic_volume_mm3": 97258.53280127086
  }
}
