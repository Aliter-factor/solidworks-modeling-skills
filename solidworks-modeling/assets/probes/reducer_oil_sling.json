{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "挡油环（oil_sling，实测型面半剖面回转）",
    "units": "mm",
    "note": "型面来自 reducer.params.json::parts.oil_sling.profile（sw_profile 从参照件面的边界圆重建，Pappus 已对账）",
    "source_params": "assets/reducer/reducer.params.json"
  },
  "params": {},
  "steps": [
    {
      "id": "n",
      "op": "new_part"
    },
    {
      "id": "p",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s1",
      "op": "sketch_begin"
    },
    {
      "id": "cl",
      "op": "centerline",
      "x1": 0.0,
      "y1": 0.0,
      "x2": 6.0,
      "y2": 0.0
    },
    {
      "id": "prof",
      "op": "polyline",
      "points": [
        [
          3.0,
          12.0
        ],
        [
          6.0,
          14.0
        ],
        [
          6.0,
          22.0
        ],
        [
          3.0,
          22.0
        ],
        [
          3.0,
          15.0
        ],
        [
          0.0,
          13.0
        ],
        [
          0.0,
          10.15
        ],
        [
          3.0,
          10.15
        ]
      ],
      "close": true,
      "note": "实测型面直线串 8 点（非单调：轴向进进出出）；闭合方式=自己闭合"
    },
    {
      "id": "s2",
      "op": "sketch_end",
      "name": "挡油环半剖面"
    },
    {
      "id": "ck",
      "op": "check_sketch_constraint",
      "sketch": "挡油环半剖面",
      "expect_min_dims": 0,
      "note": "★ 尺寸标注已封存 ⇒ 不校验尺寸条数，只记录约束状态"
    },
    {
      "id": "rev",
      "op": "revolve_boss",
      "angle": 360,
      "name": "挡油环"
    },
    {
      "id": "bb",
      "op": "check_bbox",
      "expect": [
        6.0,
        44.0,
        44.0
      ],
      "tol": 0.05,
      "note": "与参照件 25-挡油环.SLDPRT 的包围盒一致（[6, 44, 44]）"
    },
    {
      "id": "cyl",
      "op": "check_cyl_radius",
      "expect_max": 22.0,
      "tol": 0.01
    },
    {
      "id": "m",
      "op": "check_mass",
      "expect_mass_g": 3.8451,
      "tol": 0.02,
      "note": "Pappus 2π·r̄·A 由型面现算 —— 型面/毡圈槽/圆弧任何一处错，这条立刻红"
    },
    {
      "id": "diag",
      "op": "check_diagnostics",
      "fail_on": "error"
    },
    {
      "id": "sv",
      "op": "save_as",
      "path": "{{ params.out }}/25-oil_sling-44x6.SLDPRT",
      "overwrite": true
    }
  ],
  "_derived": {
    "L": 6.0,
    "Df": 44.0,
    "r_max": 22.0,
    "n_elements": 8,
