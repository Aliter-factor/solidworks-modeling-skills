{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "螺母 M8（nut_m8，六角截面拉伸）",
    "units": "mm",
    "note": "规格来自 reducer.params.json::parts.nut_m8（source=gb，唯一权威表 assets/gb_standard.json）；**不硬编码**。刻意不建螺纹与端部倒角（见代码头注）",
    "source_params": "assets/reducer/reducer.params.json"
  },
  "params": {},
  "steps": [
    {
      "id": "n",
      "op": "new_part"
    },
    {
      "id": "p",
      "op": "select_plane",
      "plane": "Front"
    },
    {
      "id": "s1",
      "op": "sketch_begin"
    },
    {
      "id": "hx",
      "op": "polyline",
      "points": [
        [
          13.0,
          0.0
        ],
        [
          6.5,
          11.25833
        ],
        [
          -6.5,
          11.25833
        ],
        [
          -13.0,
          0.0
        ],
        [
          -6.5,
          -11.25833
        ],
        [
          6.5,
          -11.25833
        ]
      ],
      "close": true,
      "note": "正六边形 对边宽 s=13（外接圆半径 = s）"
    },
    {
      "id": "hole",
      "op": "circle",
      "cx": 0.0,
      "cy": 0.0,
      "d": 8.0,
      "note": "内孔 Ø8（GB 公称；**光孔，未建内螺纹**）"
    },
    {
      "id": "s2",
      "op": "sketch_end",
      "name": "螺母 M8截面"
    },
    {
      "id": "ck",
      "op": "check_sketch_constraint",
      "sketch": "螺母 M8截面",
      "expect_min_dims": 0,
      "note": "★ 标注已封存 ⇒ 只记录约束状态"
    },
    {
      "id": "ex",
      "op": "extrude_boss",
      "depth": 6.8,
      "end_cond": "swEndCondMidPlane",
      "name": "螺母 M8",
      "note": "两个轮廓（外六角 + 内孔）一次拉伸 —— 参照件同款做法"
    },
    {
      "id": "bb",
      "op": "check_bbox",
      "expect": [
        26.0,
        22.516660498395403,
        6.8
      ],
      "tol": 0.02,
      "note": "正六边形（顶点朝 X）⇒ 包围盒 [26, 22.5167, 6.8]"
    },
    {
      "id": "m",
      "op": "check_mass",
      "expect_mass_g": 2.6439,
      "tol": 0.02,
      "note": "(3√3/2)s²·m − π/4·d²·m = 2643.9039mm³ —— **不与参照件比**（含螺纹件 mass_props 不可信，§83）"
    },
    {
      "id": "diag",
      "op": "check_diagnostics",
      "fail_on": "error"
    },
    {
      "id": "sv",
      "op": "save_as",
      "path": "{{ params.out }}/15-nut_m8-13x8x6.8.SLDPRT",
      "overwrite": true
    }
  ],
  "_derived": {
    "kind": "hex_nut",
    "s": 13.0,
    "d": 8.0,
    "thickness": 6.8,
    "gb": {
      "spec": "M8",
      "s": 13.0,
      "m": 6.8,
      "d": 8.0,
      "e": 14.38
    },
    "analytic_volume_mm3": 2643.903901376661,
    "reference_bbox_mm": [
      15.246,
      12.453,
      7.506
    ]
  }
}
