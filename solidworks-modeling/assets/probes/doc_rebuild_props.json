{
  "schema": "yoyo.swplan/1",
  "meta": {
    "name": "探针 文档杂项：rebuild 重建 + set_custom_property 写自定义属性",
    "units": "mm",
    "note": "覆盖 2 个此前无探针的 op：rebuild / set_custom_property。断言 = 写属性后几何（包围盒）不变、rebuild 不炸。"
  },
  "params": {},
  "steps": [
    {"id": "np", "op": "new_part"},
    {"id": "pl", "op": "select_plane", "plane": "Front"},
    {"id": "sb", "op": "sketch_begin"},
    {"id": "r1", "op": "rect_corner", "x1": 0, "y1": 0, "x2": 40, "y2": 30},
    {"id": "se", "op": "sketch_end", "name": "DocBoxSk"},
    {"id": "ex", "op": "extrude_boss", "depth": 10, "name": "DocBox"},
    {"id": "bb", "op": "check_bbox", "expect": [40, 30, 10], "tol_mm": 0.05},
    {"id": "rb", "op": "rebuild"},
    {"id": "cp1", "op": "set_custom_property", "name": "编号", "value": "PROBE-DOC-001"},
    {"id": "cp2", "op": "set_custom_property", "name": "设计者", "value": "YoYo Probe"},
    {"id": "bb2", "op": "check_bbox", "expect": [40, 30, 10], "tol_mm": 0.05},
    {"id": "dg", "op": "check_diagnostics"},
    {"id": "sv", "op": "save_as", "path": "{{ params.out }}/probe_doc_rebuild_props.SLDPRT",
     "overwrite": true}
  ]
}
