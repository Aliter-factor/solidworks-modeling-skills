{
  "schema": "yoyo.swplan/1",
  "meta": {"name": "单片 x4100-4110 z0-3200 可视化", "units": "mm"},
  "params": {"out": "D:/out"},
  "steps": [
    {"id": "open_shell", "op": "open", "path": "D:/out/crh380cl_nose_s4_shell.SLDPRT"},
    {"id": "base", "op": "check_volume_delta"},
    {"id": "p", "op": "select_plane", "plane": "Top"},
    {"id": "sb", "op": "sketch_begin"},
    {"id": "pl", "op": "polyline", "points": [[4100,-3200],[4110,-3200],[4110,0],[4100,0]]},
    {"id": "se", "op": "sketch_end", "name": "SLABV"},
    {"id": "cut", "op": "extrude_cut", "profile": "SLABV", "end_cond": "swEndCondThroughAllBoth", "both_directions": true, "name": "SLABV_CUT"},
    {"id": "d", "op": "check_volume_delta", "expect_mm3": -600000.0, "tol_mm3": 9.0e9},
    {"id": "sv", "op": "save_as", "path": "D:/out/slabvis.SLDPRT", "overwrite": true}
  ]
}
